{
  "name": "happy-education",
  "version": "0.1.0",
  "private": true,
  "description": "Happy Education - international education consultancy platform",
  "engines": { "node": ">=22.11.0" },
  "packageManager": "npm@11.3.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "sanity:dev": "sanity dev",
    "sanity:deploy": "sanity deploy",
    "migrate:extract": "node scripts/extract-wp.mjs",
    "migrate:import": "node scripts/import-sanity.mjs"
  },
  "dependencies": {
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "next-sanity": "13.3.3",
    "@sanity/image-url": "1.2.0",
    "sanity": "6.10.1",
    "@sanity/vision": "6.10.1",
    "styled-components": "6.1.19",
    "stripe": "22.5.0",
    "zod": "4.4.3",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "typescript": "5.9.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.6",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "vitest": "3.2.4",
    "@playwright/test": "1.62.1",
    "@axe-core/playwright": "4.11.2"
  }
}

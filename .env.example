##############################################################################
# Happy Education - environment configuration
#
# Copy to .env.local for local development:
#     cp .env.example .env.local
#
# Everything below is a DUMMY value. Never commit a real credential to this file
# or to any file in the repository. .env.local is git-ignored; .env.example is not.
#
# ---------------------------------------------------------------------------
# THE ONE RULE THAT MATTERS
#
# No secret may ever be prefixed NEXT_PUBLIC_.
#
# Next.js inlines every NEXT_PUBLIC_* value into the JavaScript bundle that is
# sent to the browser. A NEXT_PUBLIC_ variable is published, not configured.
# Server secrets are read through serverEnv() in src/lib/env.ts, which throws if
# it is ever called in the browser, so an accidental leak fails loudly instead of
# shipping quietly.
#
# ---------------------------------------------------------------------------
# EVERY INTEGRATION IS OPTIONAL
#
# The site builds and runs on a clean checkout with none of these set. Each code
# path checks isConfigured.<feature>() first and degrades to an honest state
# rather than throwing. That is why most lines here are commented out: an empty
# variable means "this feature is off", while a variable set to a plausible but
# wrong value means "this feature is broken", which is worse.
#
# Uncomment a block only when you have the real value for it.
#
# ---------------------------------------------------------------------------
# WHERE THE REAL VALUES LIVE
#
#   Vercel project settings   -> Settings > Environment Variables, per environment
#                                (Production / Preview / Development)
#   Sanity                    -> sanity.io/manage > project > API
#   Stripe                    -> dashboard.stripe.com > Developers > API keys
#   Resend                    -> resend.com/api-keys
#   Cloudflare Turnstile      -> dash.cloudflare.com > Turnstile
#
# Values are set per environment. Preview deployments must never hold production
# Stripe or CRM credentials.
##############################################################################


# =============================================================================
# SITE
# =============================================================================

# The canonical public origin, with no trailing slash.
# Used for canonical URLs, hreflang alternates, Open Graph URLs, JSON-LD @id
# values and the sitemap. Getting it wrong points every canonical tag at the
# wrong host, so it is worth checking after any domain change.
#
# Required in production. Optional locally (defaults to https://happyeducation.uk,
# which is wrong for local work, so set it).
# Local: http://localhost:3000    Production: https://happyeducation.uk
# Configure in: Vercel project settings, per environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# =============================================================================
# SANITY (content management)
#
# Without these the site still builds and every page renders. sanityFetch()
# returns its fallback, so listings are empty, CMS-backed pages 404, and the
# statically defined chrome (navigation, footer, homepage copy) is unaffected.
# =============================================================================

# The Sanity project ID. This is public by design: it appears in every asset URL
# on cdn.sanity.io and in the Studio bundle. It is an identifier, not a secret.
#
# Optional. Without it, isConfigured.sanity() is false and no CMS request is ever
# attempted, which is the correct behaviour on a clean checkout.
# Configure in: Vercel project settings, and sanity.io/manage to find the value.
# NEXT_PUBLIC_SANITY_PROJECT_ID=a1b2c3d4

# Which dataset to read. Use a separate dataset for staging content so draft work
# never appears on the live site.
# Optional, defaults to "production".
# NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API version, pinned as a date. Sanity treats this as a contract: pinning
# it means a change to their API cannot alter query results underneath a deployed
# build. Bump it deliberately, and re-test the queries when you do.
# Optional, defaults to 2026-08-01.
# NEXT_PUBLIC_SANITY_API_VERSION=2026-08-01

# Read token with viewer permissions, used ONLY for draft preview and for reading
# a private dataset. This is a genuine secret: it can read unpublished content.
#
# Optional. Without it, getPreviewClient() returns null and draft preview is
# unavailable. Published content is unaffected.
# Configure in: sanity.io/manage > API > Tokens (Viewer role), then Vercel.
# SANITY_API_READ_TOKEN=skDummyReadTokenReplaceWithARealViewerToken

# Shared secret the Sanity webhook presents when it asks the site to revalidate
# a cache tag after an editor publishes. Without it, content changes appear only
# when the ISR window expires rather than within seconds.
#
# Optional. Minimum 16 characters (enforced by the schema in src/lib/env.ts).
# Generate with: openssl rand -base64 32
# Configure in: Vercel, and the matching value in sanity.io/manage > API > Webhooks.
# SANITY_REVALIDATE_SECRET=dummy-revalidate-secret-change-me

# Shared secret that gates the draft-preview entry point, so an unauthenticated
# visitor cannot switch the site into draft mode and read unpublished content.
#
# Optional. Minimum 16 characters.
# Generate with: openssl rand -base64 32
# Configure in: Vercel, and the Studio preview configuration.
# SANITY_PREVIEW_SECRET=dummy-preview-secret-change-me


# =============================================================================
# STRIPE (payments)
#
# Without these, isConfigured.stripe() is false: payable services are not offered
# and no checkout is created. Nothing 500s.
# =============================================================================

# Publishable key. Safe in the browser by design (that is what "publishable"
# means) and required by Stripe.js for Checkout and the Payment Element.
# Must begin with pk_. Use pk_test_ everywhere except production.
# Optional.
# Configure in: Stripe dashboard > Developers > API keys, then Vercel.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_00000000000000000000000000

# Secret key. Full account access. Never expose, never log, never send to a
# client component. Must begin with sk_.
# Optional, but required together with STRIPE_WEBHOOK_SECRET for payments to
# switch on at all.
# Configure in: Stripe dashboard > Developers > API keys, then Vercel (Production
# gets the live key; Preview and Development get test keys).
# STRIPE_SECRET_KEY=sk_test_00000000000000000000000000

# Signing secret for the Stripe webhook endpoint. Every incoming webhook is
# verified against this before it is trusted. Without verification an attacker
# could post a forged "payment succeeded" event.
# Must begin with whsec_.
# Optional, but payments stay off without it.
# Configure in: Stripe dashboard > Developers > Webhooks > the endpoint > Signing
# secret. Locally, `stripe listen` prints a temporary one.
# STRIPE_WEBHOOK_SECRET=whsec_0000000000000000000000000000000000000000


# =============================================================================
# TRANSACTIONAL EMAIL
#
# Without these, isConfigured.email() is false. Enquiry forms must then either
# stay disabled or fall back to the published phone, WhatsApp and email routes.
# A form that silently accepts a submission it cannot deliver is worse than one
# that is honestly unavailable.
# =============================================================================

# Resend API key for sending enquiry notifications and confirmations.
# Optional.
# Configure in: resend.com/api-keys, then Vercel.
# RESEND_API_KEY=re_dummy_00000000000000000000000000

# The From address. Must be on a domain verified in Resend, and that domain must
# have SPF and DKIM published. See docs/URGENT-LEGACY-SITE.md section 2: the
# happyeducation.uk domain currently has no DKIM and a DMARC record it does not
# control, so sender authentication has to be fixed before this is switched on.
# Optional. Must be a valid email address.
# EMAIL_FROM=no-reply@example.com

# Internal address that receives enquiry notifications.
# Optional. Must be a valid email address.
# EMAIL_ENQUIRY_RECIPIENT=admin@example.com


# =============================================================================
# CLOUDFLARE TURNSTILE (bot protection)
#
# Both halves are needed. isConfigured.turnstile() requires the site key AND the
# secret key, because a widget the server cannot verify is decoration.
# Without them, forms fall back to their non-Turnstile protections
# (rate limiting, honeypot, server-side validation).
# =============================================================================

# Public widget key, rendered into the page. Not a secret.
# Optional.
# Configure in: Cloudflare dashboard > Turnstile > your widget.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAADummySiteKey

# Server-side verification key. Genuinely secret.
# Optional.
# Configure in: Cloudflare dashboard > Turnstile > your widget, then Vercel.
# TURNSTILE_SECRET_KEY=0x4AAAAAAADummySecretKeyValue


# =============================================================================
# CRM (optional lead destination)
#
# Sits behind the LeadProvider interface, so the enquiry pipeline does not depend
# on any particular CRM. Both values are required together; without them leads go
# to email only and nothing breaks.
# =============================================================================

# Webhook endpoint the LeadProvider posts a normalised lead to.
# Optional. Must be a valid URL.
# Configure in: Vercel, using the endpoint from whichever CRM is adopted.
# CRM_WEBHOOK_URL=https://example.invalid/webhooks/leads

# Bearer token for that endpoint. Secret.
# Optional.
# CRM_API_TOKEN=dummy-crm-token-replace-me


# =============================================================================
# ANALYTICS
#
# Nothing loads until the visitor grants the analytics consent category. With no
# container ID the site simply runs without analytics; that is a supported state,
# not a degraded one.
# =============================================================================

# Google Tag Manager container ID. Must match GTM-XXXXXXX or the build fails
# validation, which is deliberate: a malformed ID would fail silently at runtime.
# Optional.
# Configure in: Vercel. The container itself is managed in tagmanager.google.com.
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX


# =============================================================================
# SET BY THE PLATFORM - DO NOT ADD THESE YOURSELF
# =============================================================================
#
#   NODE_ENV     set by Next.js ("development", "test", "production").
#   VERCEL_ENV   set by Vercel ("production", "preview", "development").
#                src/proxy.ts reads it to send X-Robots-Tag: noindex, nofollow on
#                every non-production deployment, so preview URLs cannot be
#                indexed and compete with the live site.
